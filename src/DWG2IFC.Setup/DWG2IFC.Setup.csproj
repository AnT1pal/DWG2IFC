<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DWG2IFC-Setup</AssemblyName>
    <RootNamespace>Plant3D.IfcExporter.Setup</RootNamespace>
    <Version>1.0.0</Version>
    <OutputPath>..\..\bin\Release\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Embed payload bundle zip into the EXE -->
  <ItemGroup>
    <Resource Include="app.ico" />
    <EmbeddedResource Include="..\..\bin\Release\bundle.zip" Condition="Exists('..\..\bin\Release\bundle.zip')" />
  </ItemGroup>

</Project>
