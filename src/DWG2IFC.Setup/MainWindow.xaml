<Window x:Class="Plant3D.IfcExporter.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG2IFC (AutoCAD &amp; Plant 3D IFC Exporter)"
        Icon="app.ico"
        Width="620" SizeToContent="Height"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#1B1E23"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style x:Key="AcadButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#262A32" BorderBrush="#3A404D" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📐" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DWG2IFC — AutoCAD &amp; Plant 3D" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                        <TextBlock Text="Менеджер установки и обновления для версий 2025 и 2026" FontSize="11" Foreground="#9BA1A6" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AcadButtonStyle}" VerticalAlignment="Center" Background="#142C42" BorderBrush="#1F547E" BorderThickness="1" Padding="12,7" Click="BtnWebsite_Click" ToolTip="Перейти на сайт baidurovlabs.ru">
                    <TextBlock Text="🌐 By baidurovlabs.ru" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11"/>
                </Button>
            </Grid>
        </Border>

        <!-- Status Card -->
        <Border Grid.Row="1" Background="#262A32" BorderBrush="#3A404D" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="ТЕКУЩИЙ СТАТУС В СИСТЕМЕ:" FontSize="10" FontWeight="Bold" Foreground="#8F96A3"/>
                    <TextBlock x:Name="TxtStatus" Text="Проверка статуса..." FontSize="14" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,6"/>
                    <TextBlock x:Name="TxtPath" Text="Каталог: ApplicationPlugins" FontSize="11" Foreground="#9BA1A6" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="BtnOpenFolder" Grid.Column="1" Style="{StaticResource AcadButtonStyle}" Content="Папка..." Width="84" Height="30" VerticalAlignment="Center" Background="#343944" BorderBrush="#4D5464" BorderThickness="1" Foreground="#E2E8F0" Margin="12,0,0,0" Click="BtnOpenFolder_Click"/>
            </Grid>
        </Border>

        <!-- Description & Info -->
        <Border Grid.Row="2" Background="#21242A" BorderBrush="#323742" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Параметры и особенности плагина:" FontWeight="SemiBold" FontSize="12" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                <TextBlock Text="• Автозагрузка через бандл ApplicationPlugins (не требует прав администратора)" Foreground="#B0B5C0" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBlock Text="• Совместимость с AutoCAD 2025/2026 и AutoCAD Plant 3D 2025/2026 (.NET 8.0, x64)" Foreground="#B0B5C0" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBlock Text="• Схемы экспорта: IFC4 (TriangulatedFaceSet) и IFC2x3 (Coordination View 2.0)" Foreground="#B0B5C0" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBlock Text="• B-Rep тесселяция солидов, сварка вершин, экспорт свойств Pset и русских/англ слоёв" Foreground="#B0B5C0" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBlock Text="• Команды запуска: IFCEXPORT, PLANTTOIFC или вкладка ленты «IFC Экспорт»" FontWeight="SemiBold" Foreground="#38BDF8" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnInstall" Grid.Column="0" Style="{StaticResource AcadButtonStyle}" Content="Установить / Обновить" Height="40" Background="#0E70C0" BorderBrush="#1884DD" BorderThickness="1" Margin="0,0,8,0" Click="BtnInstall_Click"/>
            <Button x:Name="BtnUninstall" Grid.Column="1" Style="{StaticResource AcadButtonStyle}" Content="Удалить плагин" Height="40" Background="#8C2E2E" BorderBrush="#A83838" BorderThickness="1" Margin="8,0,0,0" Click="BtnUninstall_Click"/>
        </Grid>
    </Grid>
</Window>
